#!/usr/bin/env -S mycmd project run
# -*- mode: shell-script; sh-shell: bash; sh-basic-offset: 4; sh-indentation: 4; coding: utf-8 -*-
# shellcheck shell=bash

set -o nounset -o errexit -o errtrace -o pipefail

project.load_task_library "shell"

#----------------------------------------
# Project File Sets

#----------------------------------------
# Just myproject
project.register_fileset MYPROJECT_ONLY
# shellcheck disable=SC2154
project.add_files_to_fileset MYPROJECT_ONLY "${MYPROJECT_PROJECT_FILE}"

project.register_task_with_fileset list-myproject-only project.list-files MYPROJECT_ONLY
project.register_task_with_fileset format-myproject-only project:shell.format MYPROJECT_ONLY
project.register_task_with_fileset lint-myproject-only project:shell.lint MYPROJECT_ONLY

#----------------------------------------
# Python Source Files

# shellcheck disable=SC2154
readonly DATA_CLEANUP_SCRIPT="${MYPROJECT_BASE_DIR}/src/datacleanup"

project.register_fileset PYTHON_FILES
project.add_files_to_fileset PYTHON_FILES "${DATA_CLEANUP_SCRIPT}"
project.register_task_with_fileset list-python-files project.list-files PYTHON_FILES

# TODO: Lint

# TODO: Format

# TODO: Create Symlink to $HOME/.local/bin
function symlink-script-to-home-local() {
    local -r local_bin="${HOME}/.local/bin"
    local -r target_file="${local_bin}/datacleanup"

    if [[ ! -e "${target_file}" ]]; then
        project.output_only_if_not_quiet "Script file symlink to '${target_file}', missing, creating now."

        if [[ ! -d "${local_bin}" ]]; then
            project.output_only_if_not_quiet "Creating missing configuration directory '${config_dir}'."
            mkdir -p "${local_bin}"
        fi

        ln -sf "${DATA_CLEANUP_SCRIPT}" "${target_file}"
    fi
}
project.register_task symlink-script-to-home-local
